# Dependencies and build output
node_modules/
.next/
.medusa/
dist/
build/
.cache/
.vite/
*.tsbuildinfo

# Storefront templates generated by prepare-storefront.py / prepare-invoice-template.py
/apps/storefront/templates/*.html
!/apps/storefront/templates/invoice-builder.html
/apps/storefront/templates/routes.json

# Static assets downloaded by the storefront preparation scripts
/apps/storefront/public/assets/fonts/
/apps/storefront/public/assets/invoice-source/
/apps/storefront/public/wp-content/
/apps/storefront/public/wp-includes/
/apps/storefront/public/assets/vendor/masonry.pkgd.min.js
/apps/storefront/public/assets/vendor/imagesloaded.pkgd.min.js

# Local configuration and private migration data
.env
.env.*
!.env.example
.private/

# Deployment runtime data, backups, and verification reports
/shared/
artifacts/

# Logs and test output
*.log
*.log.*
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/

# Python bytecode
__pycache__/
*.py[cod]
